NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# İsteğe bağlı: tanımlıysa kayıt onay maili gönderilmeden önce, kaydın
# gerçekten var olduğu sunucu tarafında doğrulanır.
SUPABASE_SERVICE_ROLE_KEY=

SMTP_HOST=mt-spring.panel-giris.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=h2zirvesi@tespam.org
SMTP_PASS=
# Gönderen adresi. Relay servislerinde (Resend, Brevo) SMTP kullanıcı adı bir
# e-posta adresi olmadığı için ayrı tutulur; adres, relay'de doğrulanmış alan
# adına ait olmalıdır. Resend SMTP: host smtp.resend.com, port 465,
# kullanıcı adı "resend", parola API anahtarı.
MAIL_FROM=h2zirvesi@tespam.org
# Yanıtların düşeceği kutu. Boşsa MAIL_FROM kullanılır.
MAIL_REPLY_TO=h2zirvesi@tespam.org
CONTACT_TO=h2zirvesi@tespam.org
APPLICATION_NOTIFY_TO=h2zirvesi@tespam.org

GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
